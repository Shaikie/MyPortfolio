new file mode 100644
index 0000000..76c2679
--- /dev/null
+++ b/client/src/dark.css
@@ -0,0 +1,57 @@
+/* Dark variant of the bright theme. Same shapes, radii, and orange accent — new palette. */
+:root.dark {
+  --bg: #121218;
+  --text: #f2ede6;
+  --muted: #a3a8b5;
+  --orange: #fb923c;
+  --orange-dark: #f97316;
+  --peach: #241d18;
+  --pink: #201924;
+  --lav: #1b1928;
+  --amber: #221c12;
+  --shadow: 0 22px 60px rgba(0, 0, 0, .45);
+  --surface: #1b1b24;
+  --surface-2: #20202b;
+}
+
+:root.dark body { background: var(--bg) !important; color: var(--text) !important; }
+
+/* Header / nav */
+:root.dark .mobile-header { background: rgba(20, 20, 28, .78) !important; box-shadow: 0 14px 40px rgba(0, 0, 0, .35) !important; }
+:root.dark .mobile-nav { background: rgba(24, 24, 32, .95) !important; }
+:root.dark .mobile-nav a:hover { background: var(--surface-2) !important; color: var(--orange) !important; }
+:root.dark .menu-button { background: var(--text) !important; color: #121218 !important; }
+:root.dark .theme-toggle { background: var(--surface) !important; color: var(--text) !important; box-shadow: 0 10px 28px rgba(0, 0, 0, .3) !important; }
+
+/* Hero */
+:root.dark .hero-grid:before { background: radial-gradient(circle, rgba(251, 146, 60, .14), rgba(139, 92, 246, .12) 52%, transparent 72%) !important; }
+:root.dark .hero-visual { background: linear-gradient(145deg, var(--peach), var(--lav)) !important; }
+:root.dark .hero-visual:after { background: linear-gradient(145deg, rgba(20, 16, 12, .55), rgba(20, 18, 30, .4)) !important; }
+:root.dark .hero-visual-image { background: linear-gradient(145deg, rgba(251, 146, 60, .1), rgba(139, 92, 246, .12)) !important; opacity: .5; }
+:root.dark .floating-badge, :root.dark .visual-stamp { background: rgba(27, 27, 36, .85) !important; color: var(--text) !important; box-shadow: 0 16px 38px rgba(0, 0, 0, .35) !important; }
+:root.dark .button-quiet, :root.dark .text-link { background: var(--surface) !important; color: var(--text) !important; box-shadow: 0 10px 28px rgba(0, 0, 0, .3) !important; }
+
+/* Proof strip / sections */
